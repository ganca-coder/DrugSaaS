<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  租户 Mapper XML（预留）。
  当前租户的简单 CRUD 由 MyBatis-Plus BaseMapper 提供；本文件用于预留复杂 SQL 扩展点。
  注意：tenant 表为平台级表，无 tenant_id/org_id 列。
-->
<mapper namespace="com.adrug.erp.svc.user.info.mapper.TenantMapper">

    <resultMap id="BaseResultMap" type="com.adrug.erp.svc.user.info.entity.Tenant">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>

        <result column="tenant_code" property="tenantCode"/>
        <result column="tenant_name" property="tenantName"/>
        <result column="status" property="status"
                typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
        <result column="contact_name" property="contactName"/>
        <result column="contact_phone" property="contactPhone"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, create_time, update_time, create_user_id, update_user_id, deleted, version,
        tenant_code, tenant_name, status, contact_name, contact_phone, remark
    </sql>
</mapper>
