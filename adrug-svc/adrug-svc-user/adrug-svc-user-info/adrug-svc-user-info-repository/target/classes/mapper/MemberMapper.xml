<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  会员信息 Mapper XML（预留）。
  软删除字段 deleted 由 @TableLogic 自动处理，XML 中不写删除条件。
-->
<mapper namespace="com.adrug.erp.svc.user.info.mapper.MemberMapper">

    <resultMap id="BaseResultMap" type="com.adrug.erp.svc.user.info.entity.Member">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="org_id" property="orgId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>

        <result column="member_no" property="memberNo"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="gender" property="gender"/>
        <result column="id_card_no" property="idCardNo"/>
        <result column="birth_date" property="birthDate"/>
        <result column="level" property="level"/>
        <result column="discount_rate" property="discountRate"/>
        <result column="points" property="points"/>
        <result column="balance" property="balance"/>
        <result column="status" property="status"/>
        <result column="register_time" property="registerTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, org_id, create_time, update_time, create_user_id, update_user_id,
        deleted, version,
        member_no, name, phone, gender, id_card_no, birth_date, level, discount_rate, points, balance,
        status, register_time, remark
    </sql>

    <delete id="deletePhysically">
        DELETE FROM member WHERE id = #{id}
    </delete>
</mapper>
