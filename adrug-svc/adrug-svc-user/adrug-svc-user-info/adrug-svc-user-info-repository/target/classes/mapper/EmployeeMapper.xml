<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  员工信息 Mapper XML（预留）。
  <p>
  当前员工信息的简单 CRUD 由 MyBatis-Plus 的 {@code BaseMapper} 提供，无需 XML；
  本文件用于预留复杂 SQL（多表关联、自定义统计、动态条件查询等）的扩展点。
  未来新增自定义方法时，在对应 Mapper 接口声明方法，并在此补充 <select>/<update> 等节点。

  注意事项：
  1. 枚举字段（gender/status/pharmacist）落库为 code，映射时需指定 MyBatis-Plus 的
     枚举 typeHandler（MybatisEnumTypeHandler），否则默认按枚举 name 解析会出错。
  2. 软删除字段 deleted 由 @TableLogic 自动处理，XML 中不写 deleted 的删除条件。
-->
<mapper namespace="com.adrug.erp.svc.user.info.mapper.EmployeeMapper">

    <!-- 通用结果映射（含 BaseEntity 继承字段与枚举字段） -->
    <resultMap id="BaseResultMap" type="com.adrug.erp.svc.user.info.entity.Employee">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="org_id" property="orgId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>

        <result column="emp_no" property="empNo"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"
                typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
        <result column="birth_date" property="birthDate"/>
        <result column="id_card_no" property="idCardNo"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="position_id" property="positionId"/>
        <result column="entry_date" property="entryDate"/>
        <result column="resign_date" property="resignDate"/>
        <result column="status" property="status"
                typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
        <result column="pharmacist" property="pharmacist"
                typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用字段列表 -->
    <sql id="Base_Column_List">
        id, tenant_id, org_id, create_time, update_time, create_user_id, update_user_id,
        deleted, version,
        emp_no, name, gender, birth_date, id_card_no, phone, email,
        position_id, entry_date, resign_date, status, pharmacist, remark
    </sql>

    <!-- 物理删除（预留）：绕过 @TableLogic，真正从数据库删除记录。仅用于特殊清理场景。 -->
    <delete id="deletePhysically">
        DELETE FROM employee WHERE id = #{id}
    </delete>

    <!-- 预留：自定义复杂 SQL 在此追加，例如
    <select id="xxx" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM employee ...
    </select>
    -->
</mapper>
