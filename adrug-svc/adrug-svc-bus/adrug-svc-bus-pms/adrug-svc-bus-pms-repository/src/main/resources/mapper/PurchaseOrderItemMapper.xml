<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  采购订单明细 Mapper XML（预留）。
  当前简单 CRUD 由 MyBatis-Plus 的 BaseMapper 提供，无需 XML；
  本文件用于预留复杂 SQL 的扩展点。
  软删除字段 deleted 由 @TableLogic 自动处理，XML 中不写删除条件。
-->
<mapper namespace="com.adrug.erp.svc.bus.pms.mapper.PurchaseOrderItemMapper">

    <resultMap id="BaseResultMap" type="com.adrug.erp.svc.bus.pms.entity.PurchaseOrderItem">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="org_id" property="orgId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="cust1" property="cust1"/>
        <result column="cust2" property="cust2"/>
        <result column="cust3" property="cust3"/>
        <result column="cust4" property="cust4"/>
        <result column="cust5" property="cust5"/>
        <result column="cust6" property="cust6"/>

        <result column="order_id" property="orderId"/>
        <result column="seq_no" property="seqNo"/>
        <result column="drug_id" property="drugId"/>
        <result column="drug_code" property="drugCode"/>
        <result column="generic_name" property="genericName"/>
        <result column="drug_name" property="drugName"/>
        <result column="spec" property="spec"/>
        <result column="unit" property="unit"/>
        <result column="origin" property="origin"/>
        <result column="manufacturer" property="manufacturer"/>
        <result column="qty" property="qty"/>
        <result column="price" property="price"/>
        <result column="amount" property="amount"/>
        <result column="received_qty" property="receivedQty"/>
        <result column="received_amount" property="receivedAmount"/>
        <result column="received_reject_qty" property="receivedRejectQty"/>
        <result column="received_reject_amount" property="receivedRejectAmount"/>
        <result column="source_type" property="sourceType"/>
        <result column="source_order_no" property="sourceOrderNo"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, org_id, create_time, update_time, create_user_id, update_user_id,
        deleted, version, cust1, cust2, cust3, cust4, cust5, cust6,
        order_id, seq_no, drug_id, drug_code, generic_name, drug_name, spec, unit, origin,
        manufacturer, qty, price, amount, received_qty, received_amount, received_reject_qty,
        received_reject_amount, source_type, source_order_no, remark
    </sql>

    <!-- 物理删除（预留）：绕过 @TableLogic，真正从数据库删除记录。仅用于特殊清理场景。 -->
    <delete id="deletePhysically">
        DELETE FROM purchase_order_item WHERE id = #{id}
    </delete>
</mapper>
