<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  验收单明细 Mapper XML（预留）。
  当前简单 CRUD 由 MyBatis-Plus 的 BaseMapper 提供，无需 XML；
  本文件用于预留复杂 SQL 的扩展点。

  注意事项：
  1. 枚举字段（handle_type）落库为 code，映射时需指定 MybatisEnumTypeHandler。
  2. 软删除字段 deleted 由 @TableLogic 自动处理，XML 中不写删除条件。
-->
<mapper namespace="com.adrug.erp.svc.bus.pms.mapper.AcceptanceOrderItemMapper">

    <resultMap id="BaseResultMap" type="com.adrug.erp.svc.bus.pms.entity.AcceptanceOrderItem">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="org_id" property="orgId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="cust1" property="cust1"/>
        <result column="cust2" property="cust2"/>
        <result column="cust3" property="cust3"/>
        <result column="cust4" property="cust4"/>
        <result column="cust5" property="cust5"/>
        <result column="cust6" property="cust6"/>

        <result column="order_id" property="orderId"/>
        <result column="seq_no" property="seqNo"/>
        <result column="drug_id" property="drugId"/>
        <result column="drug_code" property="drugCode"/>
        <result column="generic_name" property="genericName"/>
        <result column="drug_name" property="drugName"/>
        <result column="spec" property="spec"/>
        <result column="unit" property="unit"/>
        <result column="dosage_form" property="dosageForm"/>
        <result column="origin" property="origin"/>
        <result column="manufacturer" property="manufacturer"/>
        <result column="production_license_no" property="productionLicenseNo"/>
        <result column="marketing_holder" property="marketingHolder"/>
        <result column="marketing_holder_address" property="marketingHolderAddress"/>
        <result column="approval_no" property="approvalNo"/>
        <result column="batch_no" property="batchNo"/>
        <result column="production_date" property="productionDate"/>
        <result column="expiry_date" property="expiryDate"/>
        <result column="location" property="location"/>
        <result column="received_qty" property="receivedQty"/>
        <result column="accept_qty" property="acceptQty"/>
        <result column="price" property="price"/>
        <result column="amount" property="amount"/>
        <result column="has_inspection_report" property="hasInspectionReport"/>
        <result column="supervision_code_recognizable" property="supervisionCodeRecognizable"/>
        <result column="packaging_condition" property="packagingCondition"/>
        <result column="appearance_quality" property="appearanceQuality"/>
        <result column="acceptance_status" property="acceptanceStatus"/>
        <result column="accept_time" property="acceptTime"/>
        <result column="sample_qty" property="sampleQty"/>
        <result column="reject_qty" property="rejectQty"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="reject_days" property="rejectDays"/>
        <result column="unqualified_qty" property="unqualifiedQty"/>
        <result column="unqualified_reason" property="unqualifiedReason"/>
        <result column="handle_type" property="handleType"
                typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
        <result column="pending_qty" property="pendingQty"/>
        <result column="receiver" property="receiver"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, org_id, create_time, update_time, create_user_id, update_user_id,
        deleted, version, cust1, cust2, cust3, cust4, cust5, cust6,
        order_id, seq_no, drug_id, drug_code, generic_name, drug_name, spec, unit, dosage_form,
        origin, manufacturer, production_license_no, marketing_holder, marketing_holder_address,
        approval_no, batch_no, production_date, expiry_date, location, received_qty, accept_qty,
        price, amount, has_inspection_report, supervision_code_recognizable, packaging_condition,
        appearance_quality, acceptance_status, accept_time, sample_qty, reject_qty, reject_reason,
        reject_days, unqualified_qty, unqualified_reason, handle_type, pending_qty, receiver, remark
    </sql>

    <!-- 物理删除（预留）：绕过 @TableLogic，真正从数据库删除记录。仅用于特殊清理场景。 -->
    <delete id="deletePhysically">
        DELETE FROM acceptance_order_item WHERE id = #{id}
    </delete>
</mapper>
