<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  采购入库单 Mapper XML（预留）。
  当前简单 CRUD 由 MyBatis-Plus 的 BaseMapper 提供，无需 XML；
  本文件用于预留复杂 SQL（多表关联、自定义统计、动态条件查询等）的扩展点。

  注意事项：
  1. 枚举字段（status）落库为 code，映射时需指定 MybatisEnumTypeHandler。
  2. 软删除字段 deleted 由 @TableLogic 自动处理，XML 中不写删除条件。
-->
<mapper namespace="com.adrug.erp.svc.bus.pms.mapper.PurchaseInboundOrderMapper">

    <resultMap id="BaseResultMap" type="com.adrug.erp.svc.bus.pms.entity.PurchaseInboundOrder">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="org_id" property="orgId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="cust1" property="cust1"/>
        <result column="cust2" property="cust2"/>
        <result column="cust3" property="cust3"/>
        <result column="cust4" property="cust4"/>
        <result column="cust5" property="cust5"/>
        <result column="cust6" property="cust6"/>

        <result column="order_no" property="orderNo"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="supplier_name" property="supplierName"/>
        <result column="warehouse_id" property="warehouseId"/>
        <result column="warehouse_name" property="warehouseName"/>
        <result column="invoice_type" property="invoiceType"/>
        <result column="invoice_no" property="invoiceNo"/>
        <result column="handler" property="handler"/>
        <result column="supplier_salesman" property="supplierSalesman"/>
        <result column="payment_method" property="paymentMethod"/>
        <result column="settlement_method" property="settlementMethod"/>
        <result column="pre_settlement_date" property="preSettlementDate"/>
        <result column="arrival_no" property="arrivalNo"/>
        <result column="acceptor" property="acceptor"/>
        <result column="source_order_id" property="sourceOrderId"/>
        <result column="inbound_date" property="inboundDate"/>
        <result column="status" property="status"
                typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
        <result column="total_qty" property="totalQty"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="post_time" property="postTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, org_id, create_time, update_time, create_user_id, update_user_id,
        deleted, version, cust1, cust2, cust3, cust4, cust5, cust6,
        order_no, supplier_id, supplier_name, warehouse_id, warehouse_name, invoice_type, invoice_no,
        handler, supplier_salesman, payment_method, settlement_method, pre_settlement_date, arrival_no,
        acceptor, source_order_id, inbound_date, status, total_qty, total_amount, post_time, remark
    </sql>

    <!-- 物理删除（预留）：绕过 @TableLogic，真正从数据库删除记录。仅用于特殊清理场景。 -->
    <delete id="deletePhysically">
        DELETE FROM purchase_inbound_order WHERE id = #{id}
    </delete>
</mapper>
