<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  供应商证件信息 Mapper XML（预留）。
  软删除字段 deleted 由 @TableLogic 自动处理，XML 中不写删除条件。
-->
<mapper namespace="com.adrug.erp.svc.bus.info.mapper.SupplierCertificateMapper">

    <resultMap id="BaseResultMap" type="com.adrug.erp.svc.bus.info.entity.SupplierCertificate">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="org_id" property="orgId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="cust1" property="cust1"/>
        <result column="cust2" property="cust2"/>
        <result column="cust3" property="cust3"/>
        <result column="cust4" property="cust4"/>
        <result column="cust5" property="cust5"/>
        <result column="cust6" property="cust6"/>

        <result column="supplier_id" property="supplierId"/>
        <result column="seq_no" property="seqNo"/>
        <result column="cert_type" property="certType"/>
        <result column="cert_no" property="certNo"/>
        <result column="cert_start_date" property="certStartDate"/>
        <result column="cert_expiry_date" property="certExpiryDate"/>
        <result column="business_scope" property="businessScope"/>
        <result column="issuing_authority" property="issuingAuthority"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, org_id, create_time, update_time, create_user_id, update_user_id,
        deleted, version, cust1, cust2, cust3, cust4, cust5, cust6,
        supplier_id, seq_no, cert_type, cert_no, cert_start_date, cert_expiry_date,
        business_scope, issuing_authority, remark
    </sql>

    <!-- 物理删除（预留）：绕过 @TableLogic，真正从数据库删除记录。仅用于特殊清理场景。 -->
    <delete id="deletePhysically">
        DELETE FROM supplier_certificate WHERE id = #{id}
    </delete>
</mapper>
